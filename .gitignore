# OpenTofu state holds IPs and secrets
*.tfstate
*.tfstate.*
.terraform/
*.tfplan
crash.log
crash.*.log

# Backend settings name the tenancy's bucket and namespace (example is committed)
backend.hcl

# Variables (examples are safe to commit)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local-only overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Image builds (keep in the bucket, not Git)
*.qcow2
*.raw
*.img
*.iso

# Keys and secrets
*.pem
*.key
age.key
.env
.vault_pass*
*.dec.*
*.decrypted.*
age-yubikey-identity-*.txt

# Ansible
*.retry
# Real inventory; commit only hosts.example.yml
ansible/inventory/hosts.yml

# Raw OpenSCAP output embeds /etc/shadow lines and host addresses; commit only
# copies produced by scripts/redact-openscap-report.py
reports/openscap/*-cis-report.html
reports/openscap/*-cis-results.xml

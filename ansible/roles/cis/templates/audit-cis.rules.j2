# Managed by Ansible
{% for watch in cis_audit_watches %}
-w {{ watch.path }} -p wa -k {{ watch.key }}
{% endfor %}
{% for arch in cis_audit_arches %}
{% for group in cis_audit_syscall_groups %}
-a always,exit -F arch={{ arch }} -S {{ (group.syscalls + ((group.x86 | default([])) if cis_x86 else [])) | join(',') }} {{ group.filters }} -F key={{ group.key }}
{% endfor %}
-a always,exit -F arch={{ arch }} -S execve -C uid!=euid -F euid=0 -F auid!=unset -F key=setuid
-a always,exit -F arch={{ arch }} -S execve -C gid!=egid -F egid=0 -F auid!=unset -F key=setgid
{% endfor %}
{% for exe in cis_audit_exec_paths %}
-a always,exit -F path={{ exe.path }} -F perm=x -F auid>=1000 -F auid!=unset -F key={{ exe.key }}
{% endfor %}

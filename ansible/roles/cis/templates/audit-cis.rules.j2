# Managed by Ansible
{% for arch in cis_audit_arches %}
{% for p in cis_audit_paths %}
-a always,exit -F arch={{ arch }} -F {{ p.kind }}={{ p.path }} -F perm=wa -F key={{ p.key }}
{% endfor %}
{% for s in cis_audit_syscalls if cis_x86 or not (s.x86_only | default(false)) %}
{% for exit in (s.exits | default([''])) %}
-a always,exit -F arch={{ arch }} -S {{ s.name }}{{ ' -F exit=' ~ exit if exit else '' }}{{ ' ' ~ s.extra if s.extra | default('') else '' }}{{ '' if s.no_auid | default(false) else ' ' ~ cis_audit_auid }} -F key={{ s.key }}
{% endfor %}
{% if s.auid0 | default(false) %}
-a always,exit -F arch={{ arch }} -S {{ s.name }} -F auid=0 -F key={{ s.key }}
{% endif %}
{% endfor %}
-a always,exit -F arch={{ arch }} -S execve -C euid!=uid -F auid!=unset -k user_emulation
-a always,exit -F arch={{ arch }} -S execve -C egid!=gid -F auid!=unset -k user_emulation
{% for exe in cis_audit_exec_paths %}
-a always,exit -F arch={{ arch }} -F path={{ exe }} -F perm=x {{ cis_audit_auid }} -F key=privileged
{% endfor %}
{% endfor %}

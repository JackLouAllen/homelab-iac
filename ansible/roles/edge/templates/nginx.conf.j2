# Managed by Ansible
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;

include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 1024;
}

http {
    server_tokens off;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    types_hash_max_size 4096;
    client_max_body_size 1m;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    access_log /var/log/nginx/access.log;

    ssl_ciphers PROFILE=SYSTEM;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Anything that does not match a configured name
    server {
        listen 127.0.0.1:{{ edge_public_port }} default_server;
        server_name _;
        return 404;
    }

    server {
        listen {{ edge_tailnet_ip }}:443 ssl default_server;
        server_name _;
        ssl_reject_handshake on;
    }

    # Public: reached only through cloudflared on the loopback address
{% for site in edge_public_sites %}

    server {
        listen 127.0.0.1:{{ edge_public_port }};
        server_name {{ site.host }};
        include /etc/nginx/security-headers.conf;

        set_real_ip_from 127.0.0.1;
        real_ip_header CF-Connecting-IP;

{% if site.upstream | length > 0 %}
        location / {
            proxy_pass http://{{ site.upstream }};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
        }
{% else %}
        location / {
            default_type text/plain;
            return {{ site.respond_status | default(503) }} "{{ site.respond_text | default('not deployed yet') }}\n";
        }
{% endif %}
    }
{% endfor %}

    # Private: tailnet only, wildcard certificate
{% for site in edge_private_sites %}

    server {
        listen {{ edge_tailnet_ip }}:443 ssl;
        http2 on;
        server_name {{ site.host }};

        ssl_certificate /etc/letsencrypt/live/{{ edge_cert_name }}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/{{ edge_cert_name }}/privkey.pem;

        include /etc/nginx/security-headers.conf;
{% if not edge_acme_staging %}
        add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}

{% if site.upstream | length > 0 %}
        location / {
            proxy_pass http://{{ site.upstream }};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
        }
{% else %}
        location / {
            default_type text/plain;
            return {{ site.respond_status | default(503) }} "{{ site.respond_text | default('not deployed yet') }}\n";
        }
{% endif %}
    }
{% endfor %}
}

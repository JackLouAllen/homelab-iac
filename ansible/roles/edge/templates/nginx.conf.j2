# Managed by Ansible
{% macro proxy_public(site) %}
proxy_pass http://{{ site.upstream }};
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto https;
{% if site.large_headers | default(false) %}
proxy_buffer_size 16k;
proxy_buffers 8 16k;
proxy_busy_buffers_size 32k;
{% endif %}
{% endmacro %}
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;

include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 1024;
}

http {
    server_tokens off;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    types_hash_max_size 4096;
    client_max_body_size 1m;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    access_log /var/log/nginx/access.log;
{% for site in edge_public_sites if site.rate_limit is defined %}

    # One bucket per client address (the real address from CF-Connecting-IP), per public site
    limit_req_zone $binary_remote_addr zone=login_{{ site.host | replace('.', '_') }}:10m rate={{ site.rate_limit.rate }};
    limit_req_status 429;
    limit_req_log_level warn;
{% endfor %}

    ssl_ciphers PROFILE=SYSTEM;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # GitLab's live updates use WebSockets; a connection stays plain unless the client asks to upgrade
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Anything that does not match a configured name
    server {
        listen 127.0.0.1:{{ edge_public_port }} default_server;
        server_name _;
        return 404;
    }

    server {
        listen {{ edge_tailnet_ip }}:443 ssl default_server;
        server_name _;
        ssl_reject_handshake on;
    }

    # Public: reached only through cloudflared on the loopback address
{% for site in edge_public_sites %}

    server {
        listen 127.0.0.1:{{ edge_public_port }};
        server_name {{ site.host }};
        include /etc/nginx/security-headers.conf;

        set_real_ip_from 127.0.0.1;
        real_ip_header CF-Connecting-IP;

{% if site.upstream | length > 0 and site.allow_paths is defined %}
        # Allow-list: only these paths reach the upstream, everything else is a plain 404.
        # nginx matches on the decoded, normalized path, so %-encoding and // do not get around it.
        location / {
            return 404;
        }
{% for path in site.allow_exact | default([]) %}

        location = {{ path }} {
            {{ proxy_public(site) | trim | indent(12) }}
        }
{% endfor %}
{% for path in site.allow_paths %}

        location {{ path }} {
            {{ proxy_public(site) | trim | indent(12) }}
        }
{% endfor %}
{% for realm in site.allow_realms | default([]) %}

        location /realms/{{ realm }}/ {
            {{ proxy_public(site) | trim | indent(12) }}
        }
{% endfor %}
{% for path in site.deny_exact | default([]) %}

        location = {{ path }} {
            return 404;
        }
{% endfor %}
{% for regex in site.deny_regex | default([]) %}

        # Regex locations are checked after the prefix match and win over it
        location ~* {{ regex }} {
            return 404;
        }
{% endfor %}
{% if site.rate_limit is defined and site.allow_realms | default([]) | length > 0 %}

        # Only the listed realms: a pattern over every realm would proxy the private ones as well
        location ~ ^/realms/(?:{{ site.allow_realms | join('|') }})/{{ site.rate_limit.suffix }} {
            limit_req zone=login_{{ site.host | replace('.', '_') }} burst={{ site.rate_limit.burst }} nodelay;
            {{ proxy_public(site) | trim | indent(12) }}
        }
{% endif %}
{% elif site.upstream | length > 0 %}
        location / {
            {{ proxy_public(site) | trim | indent(12) }}
        }
{% else %}
        location / {
            default_type text/plain;
            return {{ site.respond_status | default(503) }} "{{ site.respond_text | default('not deployed yet') }}\n";
        }
{% endif %}
    }
{% endfor %}

    # Private: tailnet only, wildcard certificate
{% for site in edge_private_sites %}

    server {
        listen {{ edge_tailnet_ip }}:443 ssl;
        http2 on;
        server_name {{ site.host }};

        ssl_certificate /etc/letsencrypt/live/{{ site.cert_name | default(edge_cert_name) }}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/{{ site.cert_name | default(edge_cert_name) }}/privkey.pem;

        include /etc/nginx/security-headers.conf;
{% if not edge_acme_staging %}
        add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}
{% if site.max_body_size is defined %}
        client_max_body_size {{ site.max_body_size }};
{% endif %}

{% if site.upstream | length > 0 %}
        location / {
            proxy_pass {{ site.upstream_scheme | default('http') }}://{{ site.upstream }};
{% if site.upstream_scheme | default('http') == 'https' %}
            proxy_ssl_trusted_certificate {{ site.upstream_ca }};
            proxy_ssl_verify on;
            proxy_ssl_name {{ site.upstream_name | default('localhost') }};
{% endif %}
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
{% if site.large_headers | default(false) %}
            proxy_buffer_size 16k;
            proxy_buffers 8 16k;
            proxy_busy_buffers_size 32k;
{% endif %}
{% if site.proxy_timeout is defined %}
            proxy_read_timeout {{ site.proxy_timeout }};
            proxy_send_timeout {{ site.proxy_timeout }};
{% endif %}
{% if site.no_request_buffering | default(false) %}
            proxy_request_buffering off;
{% endif %}
{% if site.websockets | default(false) %}
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
{% endif %}
        }
{% else %}
        location / {
            default_type text/plain;
            return {{ site.respond_status | default(503) }} "{{ site.respond_text | default('not deployed yet') }}\n";
        }
{% endif %}
    }
{% endfor %}
}

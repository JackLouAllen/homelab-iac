# Managed by Ansible
[Unit]
Description=GitLab audit log for Wazuh
# Not After=gitlab-runsvdir.service: that unit is ordered after multi-user.target, where this one is wanted, so
# the two wait on each other and systemd deletes this one's start job (seen on the first reboot). The logs live on
# the data volume and exist before GitLab starts; the converter exits with an error if they do not.
RequiresMountsFor={{ gitlab_audit_source_dir }}

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I {{ gitlab_audit_script }} follow {{ gitlab_audit_source_dir }} {{ gitlab_audit_log }} /var/lib/gitlab-audit/offsets.json
Restart=always
RestartSec=30
# Reads GitLab's logs, writes one file. Nothing else is writable or visible.
StateDirectory=gitlab-audit
LogsDirectory=gitlab-audit
LogsDirectoryMode=0750
UMask=0027
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
MemoryMax=128M
Nice=10

[Install]
WantedBy=multi-user.target

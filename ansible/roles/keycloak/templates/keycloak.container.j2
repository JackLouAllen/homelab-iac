# Managed by Ansible
[Unit]
Description=Keycloak
Requires=keycloak-db.service
After=keycloak-db.service

[Container]
ContainerName=keycloak
Image={{ keycloak_image }}
Pod=keycloak.pod
# "start" builds on first boot and again whenever the image or build options change.
Exec=start
Environment=KC_DB=postgres
# The database shares the pod's network namespace, so it is on this pod's loopback.
Environment=KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/{{ keycloak_db_name }}
Environment=KC_DB_USERNAME={{ keycloak_db_user }}
Secret=keycloak-db-password,type=env,target=KC_DB_PASSWORD
# TLS ends at nginx. xforwarded takes the client address from the X-Forwarded-For nginx sets
# (the real address from Cloudflare), which brute-force detection needs.
Environment=KC_HTTP_ENABLED=true
Environment=KC_PROXY_HEADERS=xforwarded
Environment=KC_HOSTNAME={{ keycloak_hostname }}
Environment=KC_HOSTNAME_ADMIN={{ keycloak_hostname_admin }}
Environment=KC_HEALTH_ENABLED=true
Environment=KC_LOG_CONSOLE_OUTPUT=json
# The jboss-logging event listener writes failed events at WARN but successful ones (logins,
# admin actions) at DEBUG, which the journal never sees. INFO makes them visible to Wazuh.
Environment=KC_SPI_EVENTS_LISTENER__JBOSS_LOGGING__SUCCESS_LEVEL=info
Environment="JAVA_OPTS_KC_HEAP={{ keycloak_java_heap }}"
NoNewPrivileges=true
DropCapability=ALL

[Service]
# The database may still be starting: retry instead of staying down.
Restart=on-failure
RestartSec=15
TimeoutStartSec=600

[Install]
WantedBy=default.target

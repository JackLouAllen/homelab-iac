# Managed by Ansible
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;

include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 1024;
}

http {
    server_tokens off;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    types_hash_max_size 4096;
    client_max_body_size 1k;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # cloudflared connects from loopback; the real client address is in CF-Connecting-IP.
    set_real_ip_from 127.0.0.1;
    real_ip_header CF-Connecting-IP;

    access_log /var/log/nginx/access.log;

    # Anything that is not one of the names below: no content.
    server {
        listen 127.0.0.1:{{ portfolio_port }} default_server;
        server_name _;
        return 404;
    }

    server {
        listen 127.0.0.1:{{ portfolio_port }};
        server_name {{ portfolio_zone }};
        root {{ portfolio_root }};
        index index.html;
        include /etc/nginx/security-headers.conf;

        location / {
            limit_except GET HEAD { deny all; }
            try_files $uri $uri/ =404;
        }
    }

    server {
        listen 127.0.0.1:{{ portfolio_port }};
        server_name www.{{ portfolio_zone }};
        return 301 https://{{ portfolio_zone }}$request_uri;
    }

    server {
        listen 127.0.0.1:{{ portfolio_port }};
        server_name {{ portfolio_status_name }};
        include /etc/nginx/security-headers.conf;
        default_type text/plain;
        return 503 "status is not deployed yet\n";
    }
}

<!-- Managed by Ansible. Custom rules use IDs from 100000 upwards. -->
<group name="local,restic,backup,">

  <!--
    systemd logs "Failed with result" for every failed unit, whatever the exit code. Wazuh's own
    rule 40704 only matches exit status 1 ("status=1/FAILURE"), and restic uses other codes (3
    unreadable files, 10 missing repository, 11 locked, 12 wrong password), which systemd prints
    as "status=10/n/a". Rule 40700 is Wazuh's base rule for systemd messages, at level 0.
  -->
  <rule id="100100" level="10">
    <if_sid>40700</if_sid>
    <regex type="pcre2">(?:restic-(?:backup|maintenance)@\S+|keycloak-dump|keycloak-db|keycloak)\.service: Failed with result</regex>
    <description>Backup or Keycloak failure: a restic, Keycloak dump, or Keycloak pod systemd unit failed.</description>
    <mitre>
      <id>T1490</id>
    </mitre>
  </rule>

  <!--
    CrowdSec writes one JSON line per alert (see the crowdsec role). The scenarios fire on repeated
    probing of the public names or of SSH, which is routine on the internet, so this is visible
    but not urgent.
  -->
  <rule id="100200" level="8">
    <decoded_as>json</decoded_as>
    <field name="program">crowdsec</field>
    <description>CrowdSec detected $(scenario) from $(source_ip).</description>
    <mitre>
      <id>T1595</id>
    </mitre>
  </rule>

</group>

<!-- Managed by Ansible. Custom rules use IDs from 100000 upwards. -->
<group name="local,restic,backup,">

  <!--
    systemd logs "Failed with result" for every failed unit, whatever the exit code. Wazuh's own
    rule 40704 only matches exit status 1 ("status=1/FAILURE"), and restic uses other codes (3
    unreadable files, 10 missing repository, 11 locked, 12 wrong password), which systemd prints
    as "status=10/n/a". Rule 40700 is Wazuh's base rule for systemd messages, at level 0.
  -->
  <rule id="100100" level="10">
    <if_sid>40700</if_sid>
    <regex type="pcre2">(?:restic-(?:backup|maintenance)@\S+|keycloak-dump|keycloak-db|keycloak|gitlab-backup|gitlab-runsvdir|gitlab-health|certbot-renew)\.service: Failed with result</regex>
    <description>Backup, Keycloak, GitLab or certificate failure: a restic, Keycloak, GitLab or certificate-renewal systemd unit failed.</description>
    <mitre>
      <id>T1490</id>
    </mitre>
  </rule>

  <!--
    CrowdSec writes one JSON line per alert (see the crowdsec role). The scenarios fire on repeated
    probing of the public names or of SSH, which is routine on the internet, so this is visible
    but not urgent.
  -->
  <rule id="100200" level="8">
    <decoded_as>json</decoded_as>
    <field name="program">crowdsec</field>
    <description>CrowdSec detected $(scenario) from $(source_ip).</description>
    <mitre>
      <id>T1595</id>
    </mitre>
  </rule>

</group>

<group name="local,keycloak,">

  <!--
    Keycloak events. The container logs one JSON line per event to the journal (program name
    "keycloak"); the interesting part is the message field, whose quotes are escaped inside the
    JSON, hence the \\" in the patterns below. Successful events only reach the journal because the
    unit sets the jboss-logging success level to info (see the keycloak role).
    No decoder: the rules match the text, so the alerts carry the whole line rather than fields.
  -->
  <rule id="100300" level="0">
    <program_name>^keycloak$</program_name>
    <match>org.keycloak.events</match>
    <description>Keycloak event log line.</description>
  </rule>

  <rule id="100301" level="5">
    <if_sid>100300</if_sid>
    <regex type="pcre2">type=\\"LOGIN_ERROR\\"</regex>
    <description>Keycloak: a sign-in failed.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- The master realm holds the admin account and is reachable on the tailnet only. -->
  <rule id="100304" level="8">
    <if_sid>100301</if_sid>
    <regex type="pcre2">realmName=\\"master\\"</regex>
    <description>Keycloak: a sign-in to the master (admin) realm failed.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100302" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100301</if_matched_sid>
    <description>Keycloak: repeated failed sign-ins (5 in 2 minutes).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100303" level="6">
    <if_sid>100300</if_sid>
    <regex type="pcre2">type=\\"LOGIN\\".*realmName=\\"master\\"</regex>
    <description>Keycloak: signed in to the master (admin) realm.</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <rule id="100305" level="5">
    <if_sid>100300</if_sid>
    <regex type="pcre2">operationType=\\"(?:CREATE|UPDATE|DELETE|ACTION)\\"</regex>
    <description>Keycloak: an admin action changed configuration.</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

</group>

<group name="local,gitlab,">

  <!--
    GitLab writes one JSON object per line to /var/log/gitlab/gitlab-rails/ (application_json.log, auth.log,
    api_json.log, production_json.log, exceptions_json.log); the Wazuh manager reads those files (wazuh_json_logs).
    Every line carries a correlation_id, which is what ties these rules to GitLab and not to other JSON logs.
    The patterns are written against real lines (scripts/gitlab-wazuh-samples.log) and are independent of field
    order. GitLab CE audits only sign-ins, so token creation, visibility changes and user creation are caught from
    the request logs instead.
  -->
  <rule id="100400" level="0">
    <decoded_as>json</decoded_as>
    <regex type="pcre2">"correlation_id":"[0-9A-Z]{26}"</regex>
    <description>GitLab log line.</description>
  </rule>

  <rule id="100401" level="5">
    <if_sid>100400</if_sid>
    <regex type="pcre2">"message":"Failed Login: username=</regex>
    <description>GitLab: a sign-in failed.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- GitLab locks an account after about ten failed sign-ins, so five close together is the time to look. -->
  <rule id="100402" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100401</if_matched_sid>
    <description>GitLab: repeated failed sign-ins (5 in 2 minutes); the account locks at about 10.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100403" level="4">
    <if_sid>100400</if_sid>
    <regex type="pcre2">"message":"Successful Login: </regex>
    <description>GitLab: someone signed in.</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <rule id="100404" level="6">
    <if_sid>100403</if_sid>
    <regex type="pcre2">"message":"Successful Login: [^"]*admin=true</regex>
    <description>GitLab: an administrator signed in.</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- Rate limits GitLab applies itself; on the public door this is what a stranger hammering search looks like. -->
  <rule id="100405" level="5">
    <if_sid>100400</if_sid>
    <regex type="pcre2">"message":"Application_Rate_Limiter_Request"</regex>
    <description>GitLab: a request hit one of its rate limits.</description>
    <mitre>
      <id>T1595</id>
    </mitre>
  </rule>

  <rule id="100406" level="8" frequency="10" timeframe="120">
    <if_matched_sid>100405</if_matched_sid>
    <description>GitLab: repeated rate-limit hits (10 in 2 minutes): the public door is being hammered.</description>
    <mitre>
      <id>T1595</id>
    </mitre>
  </rule>

  <!-- The change that exposes data: a project or group set to public, through the API or the web interface. -->
  <rule id="100407" level="9">
    <if_sid>100400</if_sid>
    <regex type="pcre2">(?=.*"method":"(?:PUT|POST)")(?=.*"path":"/api/v4/(?:projects|groups)[^"]*")(?=.*"key":"visibility","value":"public")(?=.*"status":(?:200|201))</regex>
    <description>GitLab: a project or group was made public (API).</description>
    <mitre>
      <id>T1567</id>
    </mitre>
  </rule>

  <rule id="100408" level="9">
    <if_sid>100400</if_sid>
    <regex type="pcre2">(?=.*"controller":"(?:Projects|Groups)Controller")(?=.*"action":"update")(?=.*"visibility_level":"20")(?=.*"status":(?:200|302))</regex>
    <description>GitLab: a project or group was made public (web interface).</description>
    <mitre>
      <id>T1567</id>
    </mitre>
  </rule>

  <rule id="100409" level="7">
    <if_sid>100400</if_sid>
    <regex type="pcre2">(?=.*"controller":"UserSettings::PersonalAccessTokensController")(?=.*"action":"create")(?=.*"status":(?:200|201|302))</regex>
    <description>GitLab: a personal access token was created (web interface).</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <rule id="100410" level="7">
    <if_sid>100400</if_sid>
    <regex type="pcre2">(?=.*"method":"POST")(?=.*"path":"/api/v4/users?/(?:\d+/)?personal_access_tokens")(?=.*"status":201)</regex>
    <description>GitLab: a personal access token was created (API).</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <rule id="100411" level="7">
    <if_sid>100400</if_sid>
    <regex type="pcre2">(?=.*"method":"POST")(?=.*"path":"/api/v4/users")(?=.*"status":201)</regex>
    <description>GitLab: a user account was created (API).</description>
    <mitre>
      <id>T1136</id>
    </mitre>
  </rule>

  <!-- Not under 100400: an exception raised outside a web request (a background job, a console command) has no
       correlation_id. -->
  <rule id="100412" level="6">
    <decoded_as>json</decoded_as>
    <regex type="pcre2">"exception\.class":"</regex>
    <description>GitLab raised an exception.</description>
  </rule>

  <rule id="100413" level="9" frequency="10" timeframe="300">
    <if_matched_sid>100412</if_matched_sid>
    <description>GitLab: many exceptions (10 in 5 minutes).</description>
  </rule>

</group>


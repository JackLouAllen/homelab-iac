// Tailnet access policy. Paste into the Tailscale admin console (Access controls) and use the
// preview and tests there before saving. Devices are tagged in the console:
//   oci1         -> tag:server
//   ovh1         -> tag:edge (public-facing: no access to the NAS, and only the Wazuh agent port on servers)
//   Synology     -> tag:backup
//   phone        -> tag:mobile
// The laptop and desktop stay user-owned and are matched through autogroup:admin.
{
	"tagOwners": {
		"tag:server": ["autogroup:admin"],
		"tag:edge": ["autogroup:admin"],
		"tag:backup": ["autogroup:admin"],
		"tag:mobile": ["autogroup:admin"],
	},

	"grants": [
		// Laptop and desktop: SSH and private HTTPS on servers.
		{"src": ["autogroup:admin"], "dst": ["tag:server"], "ip": ["tcp:22", "tcp:443"]},

		// Laptop and desktop: SSH and private HTTPS on the public-facing host. tag:edge faces the
		// internet, so a compromise there must not open a way inward: the only thing it may reach is
		// the Wazuh manager's agent port (the grant further down).
		{"src": ["autogroup:admin"], "dst": ["tag:edge"], "ip": ["tcp:22", "tcp:443"]},

		// Laptop and desktop: manage the NAS over SSH and DSM HTTPS.
		{"src": ["autogroup:admin"], "dst": ["tag:backup"], "ip": ["tcp:22", "tcp:5001"]},

		// Phone: private web services only, never SSH.
		{"src": ["tag:mobile"], "dst": ["tag:server"], "ip": ["tcp:443"]},

		// Servers push backups to the NAS over SFTP, and nothing else on it.
		{"src": ["tag:server"], "dst": ["tag:backup"], "ip": ["tcp:22"]},

		// Wazuh agents on the admin's own devices (the Windows desktop) report to the manager. Agents
		// authenticate with a key, so enrollment (1515) stays closed.
		{"src": ["autogroup:admin"], "dst": ["tag:server"], "ip": ["tcp:1514"]},

		// The Wazuh agent on ovh1 reports to the manager on oci1. One port, one direction; enrollment (1515)
		// stays closed because the agent's key is made on the manager.
		{"src": ["tag:edge"], "dst": ["tag:server"], "ip": ["tcp:1514"]},

		// Add when the service exists, not before:
		//   Uptime Kuma checking private services: tcp:443 between servers
	],

	"tests": [
		{"src": "tag:mobile", "accept": ["tag:server:443"], "deny": ["tag:server:22", "tag:server:1514", "tag:backup:22"]},
		{"src": "tag:server", "accept": ["tag:backup:22"], "deny": ["tag:backup:5001", "tag:backup:445"]},
		{"src": "tag:backup", "deny": ["tag:server:22", "tag:server:443", "tag:server:1514"]},
		{"src": "tag:edge", "accept": ["tag:server:1514"], "deny": ["tag:backup:22", "tag:backup:5001", "tag:server:22", "tag:server:443", "tag:server:1515"]},
	],
}
